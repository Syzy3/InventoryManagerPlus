{
  "schemaVersion": 1,
  "id": "inventory-manager-plus",
  "version": "${version}",
  "name": "Inventory Manager+",
  "description": "Save inventory layouts as presets and apply them with one click. Never drops or deletes items unless you turn on Drop.",
  "authors": [
    "Syzy3"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/inventorymanagerplus"
  },
  "license": "All Rights Reserved",
  "environment": "client",
  "icon": "assets/inventory-manager-plus/icon.png",
  "entrypoints": {
    "client": [
      "dev.inventorymanagerplus.InventoryManagerPlus"
    ],
    "modmenu": [
      "dev.inventorymanagerplus.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "inventory-manager-plus.modmenu.releases": "https://github.com/Syzy3/InventoryManagerPlus/releases"
      }
    }
  }
}
